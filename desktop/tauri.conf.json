{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Panita Client",
  "mainBinaryName": "panita-client",
  "version": "0.3.0-beta.4",
  "identifier": "com.panitacraft.client",
  "build": {
    "beforeDevCommand": "pnpm --dir ../ui dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --dir ../ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "appDirectoriesOverride": {
      "data": "$DATA/PanitaClient"
    },
    "windows": [
      {
        "title": "Panita Client",
        "width": 1100,
        "height": 700,
        "minWidth": 780,
        "minHeight": 700,
        "decorations": false,
        "backgroundColor": "#141414"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420"
    }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["panitacraft"] } },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcyMjA3OTUzQTI2N0RGNTgKUldSWTMyZWlVM2tnY29pWDFndGJmSVpnT0loUlBSb2NJZkhCWndsZDF2SnRZTkVTd2NQSm9iTFQK",
      "endpoints": ["https://github.com/panitacraft/panita-client/releases/download/updater-stable/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"],
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  }
}
