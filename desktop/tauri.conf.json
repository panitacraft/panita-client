{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Panita Client",
  "version": "0.1.0",
  "identifier": "com.panitacraft.client",
  "build": {
    "beforeDevCommand": "pnpm --dir ../ui dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --dir ../ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "appDirectoriesOverride": {
      "data": "$DATA/PanitaClient"
    },
    "windows": [
      {
        "title": "Panita Client",
        "width": 1100,
        "height": 700,
        "minWidth": 780,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420"
    }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["panitacraft"] } }
  },
  "bundle": {
    "active": false
  }
}
